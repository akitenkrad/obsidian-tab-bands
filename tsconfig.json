{
  "compilerOptions": {
    "baseUrl": ".",
    "module": "ESNext",
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "moduleResolution": "node",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "importHelpers": true,
    "isolatedModules": true,
    "allowJs": false
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "vitest.config.mts"]
}
